# Server-only settings for Vercel. Never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
MAKRAB_GM_PIN=CHANGE_TO_6_DIGITS
MAKRAB_SESSION_KEY=makrab-big-game

# Optional: enables shared mode for a build outside Vercel.
# MAKRAB_ONLINE=1
# Optional: development proxy target; default is local port 3000.
# MAKRAB_GAME_SERVER=http://127.0.0.1:3000
